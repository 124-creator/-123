  "economic_questions": [
    {
      "id": "E1",
      "question": "官方综合报价对某一合规年度挂牌收盘价能否提供额外预测信息？",
      "status": "有条件成立，未证明预测收益",
      "continue_if": [
        "目标年度/使用目的明确",
        "共同预测起点、相同信息集与目标匹配随机游走",
        "正权重制度分段，组件和综合对齐",
        "样本与非重复变化数达到预先定义门槛"
      ],
      "stop_if": [
        "仅在2026研究CEA25与综合的同期价差：制度下恒为0",
        "只重构官方权重公式",
        "只把C+B改写当方法创新"
      ],
      "scope": "预测报价，不等于可执行成交成本"
    },
    {
      "id": "E2",
      "question": "报价更新与挂牌无刷新规则是否影响预测评估？",
      "status": "制度动机成立；交易状态需按渠道及正权重组件认证",
      "continue_if": [
        "报告数量、缺失、占位、年度组件成交状态分离",
        "共同日历预测期限、状态于预测起点可得",
        "零收益不当无成交标签"
      ],
      "stop_if": [
        "综合挂牌总量被当CEA25活跃量",
        "只有全渠道混合数量却声称识别挂牌刷新",
        "想由金额除数量恢复综合收盘或潜在有效价格"
      ]
    },
    {
      "id": "E3",
      "question": "结转约束是否影响持仓、年度价差和交易时机？",
      "status": "经济机制有制度依据；无企业材料不得声称实际响应",
      "continue_if": [
        "企业行业、缺口、年度持仓、净卖出和申请资格可观测或显式情景假设",
        "年份用途及交易渠道与可用量匹配"
      ],
      "stop_if": [
        "推断所有企业都关心最新年度",
        "以日收盘代替企业可执行买卖价格",
        "没有企业需求仍宣称真实采购节约"
      ]
    },
    {
      "id": "E4",
      "question": "制度修改是否因果改变价格或流动性？",
      "status": "目前只能描述，因果门未通过",
      "continue_if": [
        "明确识别假设与估计对象",
        "处理预期和提前行为",
        "控制同期履约截止、新年度上市、供给及扩围变化",
        "有效对照/反事实、共同趋势或其他设计假设可辩护"
      ],
      "stop_if": [
        "仅前后对比/注意力/SHAP/预测误差变化",
        "只凭生效日期把混合政策变化称外生冲击"
      ]
    },
    {
      "id": "E5",
      "question": "年度配额预测能否改进真实合规采购？",
      "status": "未成立；可以限定为不证明真实节约的场景模拟",
      "continue_if": [
        "企业应清缴量、可用年度持仓、转换处理日期",
        "可执行买卖报价/深度/成交时间、数量约束",
        "交易及其他费用、预算与风险偏好",
        "独立样本外成本基准"
      ],
      "stop_if": [
        "只有收盘及历史挂牌数量",
        "无可成交性和主体需求材料"
      ]
    }
  ],
